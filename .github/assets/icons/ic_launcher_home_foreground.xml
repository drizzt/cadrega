<?xml version="1.0" encoding="utf-8"?>
<!--
    Cadrega — foreground for the Lawnchair fork adaptive icon.
    Reference: "Tre uomini e una gamba" — "Vuole una mela? Si sieda sulla cadrega."
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Chair: backrest + back leg (single continuous stroke) -->
    <path
        android:pathData="M32,26 L32,84"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>

    <!-- Chair seat -->
    <path
        android:pathData="M32,58 L78,58"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>

    <!-- Chair front leg -->
    <path
        android:pathData="M78,58 L78,84"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>

    <!-- Apple body: circle at (55, 46) r=9, drawn as two half-arcs -->
    <path
        android:pathData="M46,46 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0 Z"
        android:fillColor="#E53935"/>

    <!-- Apple stem -->
    <path
        android:pathData="M55,38 Q56,35 57,34"
        android:strokeColor="#4E342E"
        android:strokeWidth="2"
        android:strokeLineCap="round"/>

    <!-- Apple leaf -->
    <path
        android:pathData="M57,34 Q63,32 63,38 Q60,38 57,34 Z"
        android:fillColor="#2E7D32"/>

</vector>
